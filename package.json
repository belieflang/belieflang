{
  "name": "belieflang",
  "version": "0.1.1-alpha",
  "description": "A probabilistic programming language for AI agents and uncertain systems.",
  "type": "module",
  "bin": {
    "bel": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/cli.js run examples/intent.bel",
    "test": "node --test dist/tests/*.test.js",
    "dev": "tsx src/cli.ts run examples/intent.bel",
    "benchmark:jev": "npm run build && node --env-file-if-exists=.env dist/src/benchmark.js jev",
    "benchmark:chatgpt": "npm run build && node --env-file-if-exists=.env dist/src/benchmark.js chatgpt",
    "benchmark:compare": "npm run build && node --env-file-if-exists=.env dist/src/benchmark.js both",
    "benchmark:before-after": "npm run build && node --env-file-if-exists=.env dist/src/workflow_benchmark.js",
    "benchmark:chat-snapshot": "npm run build && node --env-file-if-exists=.env dist/src/chat_benchmark.js",
    "benchmark:chat-market": "npm run build && node --env-file-if-exists=.env dist/src/chat_market_benchmark.js",
    "benchmark:chat-settled": "npm run build && node --env-file-if-exists=.env dist/src/chat_settled_benchmark.js",
    "benchmark:weak-delta": "npm run build && node --env-file-if-exists=.env dist/src/weak_model_benchmark.js",
    "benchmark:hybrid-seed": "npm run build && node --env-file-if-exists=.env dist/src/chat_hybrid_benchmark.js",
    "benchmark:seed-continuation": "npm run build && node --env-file-if-exists=.env dist/src/chat_seed_benchmark.js",
    "benchmark:chat-code": "npm run build && node --env-file-if-exists=.env dist/src/chat_code_benchmark.js",
    "chatbot": "npm run build && node --env-file-if-exists=.env dist/src/chatbot.js",
    "benchmark:chat-jev": "npm run build && node --env-file-if-exists=.env dist/src/jev_chat_benchmark.js",
    "benchmark:jev-context": "npm run build && node --env-file-if-exists=.env dist/src/jev_context_benchmark.js",
    "benchmark:multidomain": "npm run build && node --env-file-if-exists=.env dist/src/multidomain_benchmark.js",
    "benchmark:multidomain:validate": "npm run benchmark:multidomain -- --validate",
    "benchmark:multidomain:report": "npm run build && node dist/src/multidomain_report.js",
    "benchmark:multidomain:experiment": "npm run build && node --env-file-if-exists=.env dist/src/multidomain_experiment.js",
    "benchmark:multidomain:continuity": "npm run benchmark:multidomain -- --prompt continuity",
    "benchmark:multidomain:compact": "npm run benchmark:multidomain -- --prompt compact"
  },
  "keywords": [
    "ai",
    "agents",
    "probabilistic-programming",
    "belief-state",
    "dsl",
    "language"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0"
  }
}
